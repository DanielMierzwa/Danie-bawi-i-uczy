<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Learning.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Learning.App.ViewModels"
    xmlns:models="clr-namespace:Learning.App.Models"
    x:DataType="vm:AccountPageViewModel"
    Title="Konto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border WidthRequest="92" HeightRequest="92" Stroke="{DynamicResource Primary}"
                        StrokeThickness="2" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light=#F3F0FF, Dark=#29223F}">
                    <Label Text="Zdjęcie" FontSize="12" HorizontalOptions="Center"
                           VerticalOptions="Center" TextColor="{DynamicResource Primary}" />
                </Border>
                <Button Grid.Column="1" Text="Wróć" VerticalOptions="Start"
                        HorizontalOptions="End" WidthRequest="110" Command="{Binding BackCommand}" />
            </Grid>

            <VerticalStackLayout Spacing="10">
                <Label Text="Nazwa" />
                <Entry x:Name="NameEntry" Placeholder="Twoja nazwa" Text="{Binding NameEntry}" IsReadOnly="{Binding IsEntryReadOnly}" />
                <Label Text="E-mail" />
                <Entry x:Name="EmailEntry" Placeholder="adres@email.com"
                       Keyboard="Email" Text="{Binding EmailEntry}" IsReadOnly="{Binding IsEntryReadOnly}" />
                <Label Text="Hasło" />
                <Entry x:Name="PasswordEntry" Placeholder="Hasło" IsPassword="True"
                       Text="{Binding PasswordEntry}" IsReadOnly="{Binding IsEntryReadOnly}" />
            </VerticalStackLayout>

            <Border Stroke="{DynamicResource Primary}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Statystyki nauki" FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource Primary}" />
                    <Label Text="Czas nauki: —" />
                    <Label Text="Rozwiązane quizy: —" />
                    <Label Text="Powtórzone fiszki: —" />
                    <Label Text="Skuteczność odpowiedzi: —" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="EditButton" Text="{Binding EditButtonText}" HorizontalOptions="Center" WidthRequest="160"
                    Command="{Binding OnEditCommand}" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Button Text="Logowanie" Command="{Binding OnLoginCommand}" />
                <Button Text="Rejestracja" Command="{Binding OnRegisterCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
