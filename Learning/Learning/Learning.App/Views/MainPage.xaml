<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Learning.App.Views.MainPage">
    <VerticalStackLayout
            Padding="0"
            Spacing="25"
            HorizontalOptions="Fill">
        <Grid ColumnDefinitions="150,*"
              RowDefinitions="150" 
              HorizontalOptions="Fill">
            <Image Source="dotnet_bot.png"/>
            <Label 
                    Grid.Column="1"
                    Text="Daniel Bawi i Uczy"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

        </Grid>
        <Grid   ColumnDefinitions="*,*,*"
                RowDefinitions="50" 
                HorizontalOptions="Fill">
            <Button Text="twoje materiały"/>
            <Button Grid.Column="1" Text="coś"/>
            <Button Grid.Column="2" Text="konto"/>
        </Grid>
        <Grid   ColumnDefinitions="*,50"
                RowDefinitions="50" 
                HorizontalOptions="Fill">
            <Entry HorizontalOptions="Fill" Text="wyszukaj"/>
            <ImageButton Grid.Column="1" Source="search.png"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>
