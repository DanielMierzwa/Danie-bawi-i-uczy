<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Learning.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:Learning.App.ViewModels"
    xmlns:models="clr-namespace:Learning.App.Models"
    x:DataType="vm:MainViewModel"
    Title="Strona główna">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">
        <!-- Nagłówek -->
        <Grid Grid.Row="0" ColumnDefinitions="76,*" ColumnSpacing="10" HeightRequest="82">
            <Border Grid.Column="0" Stroke="{DynamicResource Primary}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="6">
                <Label Text="logo" HorizontalOptions="Center" VerticalOptions="Center"
                       FontAttributes="Bold" TextColor="{DynamicResource Primary}" />
            </Border>
            <Border Grid.Column="1" Stroke="{DynamicResource Primary}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="8">
                <Label Text="Daniel bawi i uczy" HorizontalOptions="Center" VerticalOptions="Center"
                       FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- Nawigacja -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Twoje materiały" FontSize="12" Padding="6,10"
                    Clicked="OnMyMaterialsClicked" />
            <Button Grid.Column="1" Text="Coś"/>
            <Button Grid.Column="2" Text="Konto" FontSize="12" Padding="6,10"
                    Clicked="OnAccountClicked" />

        </Grid>

        <!-- Wyszukiwarka -->
        <SearchBar Grid.Row="2" Placeholder="Wyszukaj materiały..."
                   SearchButtonPressed="OnSearchPressed" />

        <!-- Materiały publiczne -->
        <Border Grid.Row="3" Stroke="{DynamicResource Primary}" StrokeThickness="1"
                StrokeShape="RoundRectangle 12" Padding="16">
            <Grid RowDefinitions="Auto,*">
                <Label Text="Materiały ogólnodostępne" FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource Primary}" HorizontalOptions="Center" />
                <VerticalStackLayout Grid.Row="1" Spacing="10" VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="Tutaj pojawią się publiczne materiały edukacyjne."
                           HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
					<CollectionView ItemsSource="{Binding Materials}"
                            VerticalOptions="Fill"
                            
                            HeightRequest="500">
						<CollectionView.ItemsLayout>
							<GridItemsLayout
								HorizontalItemSpacing="5"
								Orientation="Vertical"
								Span="4"
								VerticalItemSpacing="5" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:AbstractMaterial">
								<Border HeightRequest="150"
										WidthRequest="150"
										Padding="10">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="15"/>
									</Border.StrokeShape>
									<VerticalStackLayout>
										<Label HorizontalOptions="Center"
											   Text="{Binding Title}"/>
										<Label HorizontalOptions="Center"
											   Text="{Binding CreatorLogin, StringFormat='Stworzono przez {0}'}"/>
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
