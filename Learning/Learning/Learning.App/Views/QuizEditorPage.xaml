<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Learning.App.Views.QuizEditorPage"
             Title="Edytor quizu">

    <!--
        BindingContext = QuizEditorViewModel (wstrzykiwany w code-behind). Bindingi bez x:DataType.
        FallbackValue to wartość widoczna w podglądzie, dopóki nie ma viewmodelu.
        Popupy (usuń pytanie, wyjdź) to DisplayAlert w QuizEditorViewModel.
        Blokowanie przycisków robi CanExecute komend.
    -->
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- Pasek górny: [<] [>] [X]   pytanie x / y   [wyjdź] [zapisz] [+] -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

            <HorizontalStackLayout Spacing="4">
                <ImageButton Style="{StaticResource IconButton}" Source="arrow_left.png"
                             Command="{Binding PreviousQuestionCommand}" />
                <ImageButton Style="{StaticResource IconButton}" Source="arrow_right.png"
                             Command="{Binding NextQuestionCommand}" />
                <ImageButton Style="{StaticResource IconButton}" Source="close.png"
                             Command="{Binding DeleteQuestionCommand}" />
            </HorizontalStackLayout>

            <Label Grid.Column="1" Style="{StaticResource FormCaption}"
                   Text="{Binding QuestionCounterText, FallbackValue='pytanie 1 / 1'}" />

            <HorizontalStackLayout Grid.Column="2" Spacing="8">
                <Button Style="{StaticResource SecondaryButton}" Text="wyjdź"
                        Command="{Binding ExitCommand}" VerticalOptions="Center" />
                <Button Text="zapisz"
                        Command="{Binding SaveCommand}" VerticalOptions="Center" />
                <ImageButton Style="{StaticResource IconButton}" Source="plus.png"
                             Command="{Binding AddQuestionCommand}" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <Grid>

                <!-- Formularz pytania -->
                <Border Style="{StaticResource FormCard}" VerticalOptions="Start">
                    <VerticalStackLayout Spacing="12">

                        <Border Style="{StaticResource FieldBorder}">
                            <Entry Placeholder="pytanie" Text="{Binding QuestionText}" />
                        </Border>

                        <!-- Odpowiedzi (max 4): [checkbox = poprawna] [treść] [X = usuń]. Odpowiedź 1 jest zawsze, reszta zależy od AnswerCount. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding AnswerCorrect[0]}" />
                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="odpowiedź 1" Text="{Binding AnswerTexts[0]}" />
                            </Border>
                            <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="close.png"
                                         Command="{Binding DeleteAnswerCommand}" CommandParameter="1" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding IsAnswer2Visible}">
                            <CheckBox IsChecked="{Binding AnswerCorrect[1]}" />
                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="odpowiedź 2" Text="{Binding AnswerTexts[1]}" />
                            </Border>
                            <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="close.png"
                                         Command="{Binding DeleteAnswerCommand}" CommandParameter="2" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding IsAnswer3Visible}">
                            <CheckBox IsChecked="{Binding AnswerCorrect[2]}" />
                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="odpowiedź 3" Text="{Binding AnswerTexts[2]}" />
                            </Border>
                            <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="close.png"
                                         Command="{Binding DeleteAnswerCommand}" CommandParameter="3" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding IsAnswer4Visible}">
                            <CheckBox IsChecked="{Binding AnswerCorrect[3]}" />
                            <Border Grid.Column="1" Style="{StaticResource FieldBorder}">
                                <Entry Placeholder="odpowiedź 4" Text="{Binding AnswerTexts[3]}" />
                            </Border>
                            <ImageButton Grid.Column="2" Style="{StaticResource IconButton}" Source="close.png"
                                         Command="{Binding DeleteAnswerCommand}" CommandParameter="4" />
                        </Grid>

                        <!-- dodaj odpowiedź (max 4 - blokuje CanExecute) -->
                        <ImageButton Style="{StaticResource IconButton}" Source="plus.png"
                                     HorizontalOptions="Center"
                                     Command="{Binding AddAnswerCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
