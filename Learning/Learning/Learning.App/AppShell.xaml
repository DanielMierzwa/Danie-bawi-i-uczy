<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Learning.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Learning.App"
    xmlns:views="clr-namespace:Learning.App.Views"
    Title="Learning.App">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />
    <ShellContent
    Title="Użytkownik"
    ContentTemplate="{DataTemplate views:UserMenuPage}"
    Route="UserMenuPage" />
    <ShellContent
    Title="edytor"
    ContentTemplate="{DataTemplate views:FlashcardEditorPage}"
    Route="FlashcardEditorPage" />

</Shell>
